{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "HttpsRedirection": {
    "HttpsPort": 443
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "EnableSsl": true,
    "RecipientEmail": "",
    "TimeoutSeconds": 10
  },
  "Captcha": {
    "Enabled": true,
    "SecretKey": "",
    "VerificationUrl": "https://challenges.cloudflare.com/turnstile/v0/siteverify",
    "TimeoutSeconds": 5
  },
  "ContactSecurity": {
    "MaxRequestBodyBytes": 16384,
    "MinimumCompletionSeconds": 3
  },
  "RateLimiting": {
    "Contact": {
      "PermitLimit": 5,
      "WindowMinutes": 10
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://globaccountservices.com",
      "https://www.globaccountservices.com"
    ]
  },
  "SecurityHeaders": {
    "ContentSecurityPolicy": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
  },
  "AllowedHosts": "localhost;127.0.0.1;globaccountservices.com;www.globaccountservices.com;api.globaccountservices.com;*.onrender.com"
}
